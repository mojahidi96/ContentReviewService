# ContentReviewService configuration.
# Copy to .env for local development. Every value is validated at startup (src/config/env.ts);
# the process exits with a list of invalid variable names if anything is wrong.
# NEVER commit real secrets. Generate secrets with:  openssl rand -base64 48

# --- Runtime -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# json (default; required in production, parsed by log collectors) | pretty (local dev only)
LOG_FORMAT=pretty
# Express "trust proxy": false | true | <hop count> | <subnet list>. Set when behind a load balancer.
TRUST_PROXY=false

# --- MongoDB -------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/content_review

# --- Browser access ------------------------------------------------------------
# Comma-separated allowlist of exact origins (scheme://host[:port]) for CORS and Origin checks.
FRONTEND_ORIGIN=http://localhost:4200

# --- Authentication ------------------------------------------------------------
# >= 32 chars. Must differ from CSRF_SECRET in production.
AUTH_JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
AUTH_JWT_ISSUER=content-review-service
AUTH_JWT_AUDIENCE=content-review-ui
AUTH_COOKIE_NAME=content_review_session
# Must be true in production (HTTPS only).
AUTH_COOKIE_SECURE=false
# lax (default, UI and API on the same site) | strict | none (cross-site; requires Secure)
AUTH_COOKIE_SAMESITE=lax
# Session lifetime: seconds or 15m / 12h / 7d.
AUTH_TOKEN_TTL=15m
BCRYPT_ROUNDS=12

# --- CSRF ----------------------------------------------------------------------
CSRF_SECRET=replace_with_another_strong_random_secret_32_chars
# In production over HTTPS consider the __Host- prefix, e.g. __Host-content_review_csrf
CSRF_COOKIE_NAME=content_review_csrf

# --- Emailed codes (sign-in and password reset) ---------------------------------
OTP_TTL_SECONDS=300
# Failed guesses allowed per code; the code is deleted after that many.
OTP_MAX_ATTEMPTS=5
# Required in production (>= 32 chars, different from the other secrets). Used to HMAC stored codes.
# Outside production it is derived from AUTH_JWT_SECRET when unset.
# OTP_HMAC_SECRET=replace_with_a_third_strong_random_secret
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_REQUEST_LIMIT_PER_EMAIL=3
OTP_REQUEST_LIMIT_PER_IP=10
# Verify limits count failed attempts only.
OTP_VERIFY_LIMIT_PER_EMAIL=10
OTP_VERIFY_LIMIT_PER_IP=30
# console = print codes to the API's stdout instead of emailing them (development only; startup
#           refuses it when NODE_ENV=production). Nothing is sent, so no inbox ever gets a code.
# smtp    = send real email via SMTP_URL (nodemailer); SMTP_URL and MAIL_FROM are then required.
MAIL_TRANSPORT=console
# Percent-encode special characters in the user/password (e.g. @ becomes %40).
# Gmail for development: smtps://you%40gmail.com:<16-char app password>@smtp.gmail.com:465
#   (needs 2-Step Verification and an App Password; the normal account password is rejected).
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="ContentReview <no-reply@example.com>"
# A failed send never changes the API response (always 202); check the API log for
# "Emailed code could not be sent". Never commit real credentials: keep them in .env only.

# --- Python LLM service (separate repository) -----------------------------------
# http = call the real service; mock = built-in rule-based stand-in (development/tests only).
PYTHON_LLM_MODE=http
AI_SERVICE_BASE_URL=http://localhost:8000
# Shared bearer credential (never logged); >= 16 chars when PYTHON_LLM_MODE=http.
INTERNAL_SERVICE_TOKEN=replace_with_a_secret_service_token
# The review call is synchronous and LLM-backed, so allow about a minute.
PYTHON_LLM_TIMEOUT_MS=60000
PYTHON_LLM_CONNECT_TIMEOUT_MS=5000
# Include the Python service in /health/ready (reported, never fails readiness).
PYTHON_LLM_HEALTH_CHECK=true

# --- Background processing -----------------------------------------------------
# Run the job worker inside the API process. Set false when running `npm run start:worker` separately.
WORKER_ENABLED=true
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=4
JOB_POLL_INTERVAL_MS=1000
# Lease must exceed the Python timeout; defaults to PYTHON_LLM_TIMEOUT_MS + 30000.
# JOB_LEASE_MS=90000
JOB_BACKOFF_BASE_MS=2000
JOB_BACKOFF_MAX_MS=60000
JOB_RECOVERY_INTERVAL_MS=30000
JOB_ORPHAN_AGE_MS=60000

# --- Reviews -------------------------------------------------------------------
# Max content length in Unicode code points (<= 100000, the AI service limit).
REVIEW_MAX_CONTENT_CHARS=50000
# Saved author documents (code points). Keep <= REVIEW_MAX_CONTENT_CHARS so any saved document can be reviewed.
DOCUMENT_MAX_CONTENT_CHARS=50000
# Reviews (including stored content) are deleted automatically after N days. 0 = keep forever.
REVIEW_RETENTION_DAYS=90
BODY_LIMIT=512kb

# --- Server-Sent Events --------------------------------------------------------
SSE_HEARTBEAT_MS=15000
SSE_POLL_INTERVAL_MS=1000
SSE_RETRY_MS=3000

# --- Rate limiting (per client IP, per instance) --------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Metrics -------------------------------------------------------------------
# Prometheus /metrics on a separate internal listener (never the public PORT).
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9464

SHUTDOWN_GRACE_MS=10000
